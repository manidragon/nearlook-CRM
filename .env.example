# ==============================================================================
# Environment Configuration for Nearlook Agency ERP & IT CRM
# ==============================================================================

# Server Port (Default is 3000 inside Docker/Coolify)
PORT=3000

# Persistent Data Storage Directory (Docker volume path)
DATA_DIR="/app/data"

# Application Branding & URLs
NEXT_PUBLIC_APP_NAME="Nearlook Agency ERP & CRM"
NEXT_PUBLIC_APP_URL="https://crm.yourdomain.com"

# AES-256 Credentials Vault Secret Key (64-character hex string = 32 bytes)
# Generate a new secure 64-char hex key for production:
# e.g., openssl rand -hex 32
VAULT_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Meta WhatsApp Cloud API Settings (Graph API v20.0)
# Get credentials from https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_CLOUD_API_TOKEN="EAABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="109283746592019"
WHATSAPP_BUSINESS_ACCOUNT_ID="294857201948572"

# WhatsApp Mode: Set to "false" in production to hit live Meta API, "true" to safely simulate
WHATSAPP_SIMULATION_MODE="true"
